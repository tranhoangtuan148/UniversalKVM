{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UniversalKVM",
  "version": "1.0.3",
  "identifier": "com.universalkvm.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "UniversalKVM",
        "width": 800,
        "height": 600,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "UniversalKVM, a software KVM that shares one keyboard and mouse across multiple computers, with clipboard sharing, file transfer, and custom monitor borders.",
    "shortDescription": "UniversalKVM"
  }
}
